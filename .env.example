# Token de acesso da conta Vercel.
# Crie um novo em: https://vercel.com/account/tokens
# NUNCA comite este valor. No Vercel, adicione em Settings > Environment Variables.
VERCEL_TOKEN=coloque_seu_token_aqui

# Opcional: informe o ID do time apenas se os projetos pertencerem a um
# time (Team) e não à sua conta pessoal. Encontre em Team Settings.
VERCEL_TEAM_ID=
